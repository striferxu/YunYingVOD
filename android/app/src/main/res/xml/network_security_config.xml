<?xml version="1.0" encoding="utf-8"?>
<!--
  network_security_config.xml

  只为 P5 的本地媒体代理开口子：ExoPlayer 连 127.0.0.1 的明文 HTTP。

  背景（详见 docs/P5_ACCEPTANCE.md 第 6 节）：真机网络对 SNI=*.ccwu.cc 做了
  TLS 特征阻断，Android 原生 TLS 栈建连即被 RST。绕行方案是由 Dart（能通）
  在 App 内起一个仅监听 127.0.0.1 的代理，ExoPlayer 只连本机明文 HTTP。

  注意：
  * 只对 127.0.0.1 放开 cleartext，其余域名仍强制 HTTPS。
  * base-config 保持 cleartextTrafficPermitted="false"。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
